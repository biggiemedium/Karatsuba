# Lombok settings for the mod. Core has its own, with stopBubbling set, so the two
# are independent despite core/ sitting inside this directory.
config.stopBubbling = true

# Marks generated members with @lombok.Generated, which keeps them out of coverage
# reports and tells static analysis they were not hand-written.
lombok.addLombokGeneratedAnnotation = true

# @AllArgsConstructor would otherwise emit java.beans.ConstructorProperties, which
# is in the java.desktop module and not on a Minecraft classpath.
lombok.anyConstructor.addConstructorProperties = false
